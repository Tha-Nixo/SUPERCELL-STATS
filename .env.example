# Supercell API keys — get them from the developer portals (IP-bound):
#   https://developer.clashroyale.com
#   https://developer.brawlstars.com
#   https://developer.clashofclans.com
#
# SECURITY WARNING: anything prefixed VITE_ is embedded in the client JS bundle.
# This is acceptable for local development only — never deploy a build with real
# keys until the backend proxy exists (see GitHub issues #2 and #3).

VITE_CLASH_ROYALE_API_KEY=
VITE_BRAWL_STARS_API_KEY=
VITE_CLASH_OF_CLANS_API_KEY=

# Set to "true" to force randomly-generated demo data (no API calls).
# In production leave everything above EMPTY: the reverse proxy injects
# the keys server-side (see DEPLOY.md).
VITE_DEMO_MODE=

