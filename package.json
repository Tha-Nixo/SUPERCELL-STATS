{
  "name": "supercell-stats",
  "version": "1.0.0",
  "description": "Player statistics website for Supercell games (Clash Royale, Brawl Stars, Clash of Clans) powered by the official Supercell developer APIs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender-shells.mjs && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tha-Nixo/SUPERCELL-STATS.git"
  },
  "keywords": [
    "supercell",
    "clash-royale",
    "brawl-stars",
    "clash-of-clans",
    "stats",
    "react",
    "vite"
  ],
  "author": "Tha-Nixo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tha-Nixo/SUPERCELL-STATS/issues"
  },
  "homepage": "https://github.com/Tha-Nixo/SUPERCELL-STATS#readme"
}
